# Copia este archivo como .env y cambia los valores antes de publicar.
SECRET_KEY=pon-aqui-una-clave-larga-aleatoria
# Opcional: si falta, el cifrado se deriva de SECRET_KEY. No la cambies con claves ya guardadas.
API_KEY_ENCRYPTION_KEY=otra-clave-larga-y-estable

# SQLite para desarrollo; en producción usa PostgreSQL.
DATABASE_URL=sqlite:///./nexia.db

# Cuenta administradora inicial.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=una-contrasena-segura-de-12-caracteres
# Solo para una instalación local vacía; se recomienda mantenerlo en false.
FIRST_USER_IS_ADMIN=false

# Proveedor documentado en API Usage Guide.pdf.
API_BASE_URL=https://api.mwapi.dev/v1
TRIAL_API_KEY=
DAILY_MESSAGE_LIMIT=3

# OAuth de Google (cliente OAuth tipo "Aplicación web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En producción: https://tu-dominio.com (sin barra final).
APP_BASE_URL=http://localhost:8000

# Actívalo en producción si el proxy no informa correctamente el esquema HTTPS.
COOKIE_SECURE=false

# Recomendado para Render Free: API HTTPS de Resend con un dominio verificado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=acceso@tudominio.com

# Alternativa SMTP (Render Free bloquea 25/465/587). Ejemplo Gmail: smtp.gmail.com / 587.
# Usa una contraseña de aplicación, no la contraseña normal del correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nexia AI
SMTP_USE_TLS=true
# Solo desarrollo/pruebas: muestra el código en pantalla y no envía correo.
DEBUG_VERIFICATION_CODES=false
